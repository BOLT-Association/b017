/-- **The real grandparent is the parsed one**: a well-formed transaction whose txid is the spent token's
other grandparent and whose serialisation has no second preimage is `gpTxB`. -/
theorem gp_eq_gpTxB {f : Fields} {a : Args} {S : List Bytes} {t1 t0 a1 a2 : Bytes} {w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes} {G : Tx}
    (h1 : rebuildB_1_fact1 t1 t0 a1 a2 (gateT f a S) w10 w11 w12 w13 w14 w17 w18 w19 w20 w23)
    (hw : WidthsB t1 t0 a1 a2 (gateT f a S) w10 w11 w12 w13 w14 w17 w18 w19 w20 w23)
    (hG : TxWF G) (hnsp : ∀ y, Hash.hash256 y = Hash.hash256 (serTx G) → y = serTx G)
    (htxid : txid G = List.take 32 f.ogp) :
    G = gpTxB t1 t0 a1 a2 (gateT f a S) w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 := by
  rw [rebuildB_1_fact1_eq, gateT_item41] at h1
  have hX : rebuiltB1 t1 t0 a1 a2 (gateT f a S) w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 = serTx G := hnsp _ (by rw [h1, ← htxid]; rfl)
  exact eq_of_serTx hG hX (decode_rebuiltB t1 t0 a1 a2 (gateT f a S) w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 hw)


end BoltProof.Glue.SimpleMulti
