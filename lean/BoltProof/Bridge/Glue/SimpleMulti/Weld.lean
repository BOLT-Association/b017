import BoltProof.Bridge.Glue.SimpleMulti.Abs
import BoltProof.Bridge.Glue.SimpleMulti.Enforced

/-!
# `SimpleMultiBOLT`: the welds

What the run's facts say about the spend once the scriptCode the preimage carries is the spent lock
(`sc pre = lockScript f`, which `PushTxSound` and the sighash weld give): each push the covenant reads off the
scriptCode at a fixed offset is the matching field's push (the per-field lemmas were generated by the glue's
`gen_weld.py`), and the locks the covenant builds are fungible locks of the fields the model's tokens describe.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Params BsvScript.Numbers BsvScript.Machine BsvScript.Gadget
open BoltProof.Bridge.Generated
open BoltProof.Glue.MinSimple (sc scLen preOutpoint)

theorem suffix_length : SimpleMulti.suffix.length = 4700 := by decide +kernel

theorem lockScript_length_eq {f : Fields} (hwf : WF f) : (lockScript f).length = 4946 := by
  rw [lockScript_length hwf, suffix_length]

/-- The push of `bal`, read off the scriptCode at offset 0. -/
theorem scPush_bal {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 17 (sc pre) = 16 :: f.bal := by
  simp only [hsc, lockScript, List.take_succ_cons, List.take_left' hwf.bal]

/-- The push of `balCommit`, read off the scriptCode at offset 17. -/
theorem scPush_balCommit {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 17 (List.drop 17 (sc pre)) = 16 :: f.balCommit := by
  simp only [hsc, lockScript_drop_17 hwf, List.take_succ_cons, List.take_left' hwf.balCommit]

/-- The push of `pkh`, read off the scriptCode at offset 34. -/
theorem scPush_pkh {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 21 (List.drop 34 (sc pre)) = 20 :: f.pkh := by
  simp only [hsc, lockScript_drop_34 hwf, List.take_succ_cons, List.take_left' hwf.pkh]

/-- The push of `com`, read off the scriptCode at offset 55. -/
theorem scPush_com {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 21 (List.drop 55 (sc pre)) = 20 :: f.com := by
  simp only [hsc, lockScript_drop_55 hwf, List.take_succ_cons, List.take_left' hwf.com]

/-- The push of `com2`, read off the scriptCode at offset 76. -/
theorem scPush_com2 {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 21 (List.drop 76 (sc pre)) = 20 :: f.com2 := by
  simp only [hsc, lockScript_drop_76 hwf, List.take_succ_cons, List.take_left' hwf.com2]

/-- The push of `ogp`, read off the scriptCode at offset 97. -/
theorem scPush_ogp {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 37 (List.drop 97 (sc pre)) = 36 :: f.ogp := by
  simp only [hsc, lockScript_drop_97 hwf, List.take_succ_cons, List.take_left' hwf.ogp]

/-- The push of `ty`, read off the scriptCode at offset 134. -/
theorem scPush_ty {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 2 (List.drop 134 (sc pre)) = 1 :: f.ty := by
  simp only [hsc, lockScript_drop_134 hwf, List.take_succ_cons, List.take_left' hwf.ty]

/-- The push of `outIdx`, read off the scriptCode at offset 136. -/
theorem scPush_outIdx {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 2 (List.drop 136 (sc pre)) = 1 :: f.outIdx := by
  simp only [hsc, lockScript_drop_136 hwf, List.take_succ_cons, List.take_left' hwf.outIdx]

/-- The push of `parent`, read off the scriptCode at offset 138. -/
theorem scPush_parent {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 37 (List.drop 138 (sc pre)) = 36 :: f.parent := by
  simp only [hsc, lockScript_drop_138 hwf, List.take_succ_cons, List.take_left' hwf.parent]

/-- The push of `gp`, read off the scriptCode at offset 175. -/
theorem scPush_gp {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 37 (List.drop 175 (sc pre)) = 36 :: f.gp := by
  simp only [hsc, lockScript_drop_175 hwf, List.take_succ_cons, List.take_left' hwf.gp]

/-- The push of `issuer`, read off the scriptCode at offset 212. -/
theorem scPush_issuer {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    List.take 34 (List.drop 212 (sc pre)) = 33 :: f.issuer := by
  simp only [hsc, lockScript_drop_212 hwf, List.take_succ_cons, List.take_left' hwf.issuer]

/-- The suffix, read off the scriptCode after the pushes. -/
theorem scSuffix_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scSuffix pre = SimpleMulti.suffix := by
  simp only [scSuffix, hsc, lockScript_drop_246 hwf]

theorem scBalPush_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scBalPush pre = 16 :: f.bal := scPush_bal hwf hsc
theorem scPkhPush_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scPkhPush pre = 20 :: f.pkh := scPush_pkh hwf hsc
theorem scComPush_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scComPush pre = 20 :: f.com := scPush_com hwf hsc
theorem scParentPush_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scParentPush pre = 36 :: f.parent := scPush_parent hwf hsc
theorem scIssuerPush_of_sc {f : Fields} (hwf : WF f) {pre : Bytes} (hsc : sc pre = lockScript f) :
    scIssuerPush pre = 33 :: f.issuer := scPush_issuer hwf hsc

/-! ## The produced locks as fungible locks -/

/-- The fields of the token a commit creates at the first token input: the old balance, the committed balance
`balCommit`, the old owner, `com = pkh1`, the second commitment `com2`, the other lineage `ogp`, the next type,
the index byte, this outpoint as parent, the old parent as grandparent, the issuer. -/
def commitFields (f : Fields) (a : Args) (balCommit com2 ogp : Bytes) : Fields :=
  { bal := f.bal, balCommit := balCommit, pkh := f.pkh, com := a.pkh1, com2 := com2, ogp := ogp, ty := a.nty,
    outIdx := [inIdxByte a], parent := preOutpoint a.pre, gp := f.parent, issuer := f.issuer }

/-- The widths of the unlocking arguments the commit copies into the new lock unchecked. -/
structure ArgsWF (a : Args) : Prop where
  nbc : a.nbc.length = 16
  pkh1 : a.pkh1.length = 20
  pkh2 : a.pkh2.length = 20
  nty : a.nty.length = 1
  i1 : a.i1.length = 36
  i2 : a.i2.length = 36
  i3 : a.i3.length = 20
  outpoint : (preOutpoint a.pre).length = 36

theorem commitFields_wf {f : Fields} {a : Args} {balCommit com2 ogp : Bytes} (hwf : WF f) (ha : ArgsWF a)
    (hb : balCommit.length = 16) (hc : com2.length = 20) (ho : ogp.length = 36) :
    WF (commitFields f a balCommit com2 ogp) :=
  ⟨hwf.bal, hb, hwf.pkh, ha.pkh1, hc, ho, ha.nty, rfl, ha.outpoint, hwf.parent, hwf.issuer⟩

/-- The commit lock the covenant builds is the fungible lock of `commitFields`. -/
theorem commitLock_eq {f : Fields} {a : Args} (hwf : WF f) (hsc : sc a.pre = lockScript f) (balCommit com2 ogp : Bytes) :
    commitLock a balCommit com2 ogp = lockScript (commitFields f a balCommit com2 ogp) := by
  simp only [commitLock, lockOf, scBalPush_of_sc hwf hsc, scPkhPush_of_sc hwf hsc, scParentPush_of_sc hwf hsc,
    scIssuerPush_of_sc hwf hsc, scSuffix_of_sc hwf hsc, lockScript, commitFields, List.append_assoc,
    List.cons_append, List.singleton_append, List.nil_append]

end BoltProof.Glue.SimpleMulti
