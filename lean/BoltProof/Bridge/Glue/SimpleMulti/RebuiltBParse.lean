    rebuiltB1 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 =
      item T 136 ++ ([2] ++ (((item T 135 ++ ((253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) ++ (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 ++ item T 108))) ++ (item T 79 ++ (encode ((item T 78).length : Int) ++ (item T 78 ++ item T 77)))) ++ ([3] ++ (((item T 30 ++ (item T 0 ++ lkB T)) ++ ((item T 30 ++ (item T 12 ++ (item T 66 ++ [136, 172]))) ++ (item T 64 ++ ([25] ++ item T 63)))) ++ item T 62)))) := by
  simp only [rebuiltB1, scB0, scB2, lkB, secondInB, secondOutB, h65, h107, encode_zero, castToBool_nil,
    castToBool_encode_one, Bool.false_eq_true, ↓reduceIte, List.append_assoc, List.cons_append, List.nil_append,
