/-- The rebuilt other grandparent as `decodeTx` reads it: the second token input and the second proof output present
when their flags are. -/
def gpTxB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) : Tx :=
  { version := toInt32 (leNat (item T 136)),
    inputs := inOfBytes (item T 135) (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (item T 108) ::
      ((if decode (item T 107) = 0 then [] else
        [inOfBytes ((t1 :: t0 :: T)[109]?.getD []) (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) ((t1 :: t0 :: T)[82]?.getD [])]) ++
        [inOfBytes (item T 79) (item T 78) (item T 77)]),
    outputs := outOfBytes (item T 30) (lkB T) ::
      outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 66 ++ [136, 172])) ::
      ((if decode (item T 65) = 0 then [] else
        [outOfBytes ((t1 :: t0 :: T)[32]?.getD []) (((t1 :: t0 :: T)[14]?.getD []).drop 1 ++ ((t1 :: t0 :: T)[67]?.getD [] ++ [136, 172]))]) ++
        [outOfBytes (item T 64) (item T 63)]),
    lockTime := leNat (item T 62) }

/-- The widths the parse of the rebuilt other grandparent reads. -/
structure WidthsB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) : Prop where
  ver : (item T 136).length = 4
  op0 : (item T 135).length = 36
  vi0 : VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length
  sq0 : (item T 108).length = 4
  op2 : ¬ decode (item T 107) = 0 → ((t1 :: t0 :: T)[109]?.getD []).length = 36
  vi2 : ¬ decode (item T 107) = 0 →
    VarIntOf (253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length
  sq2 : ¬ decode (item T 107) = 0 → ((t1 :: t0 :: T)[82]?.getD []).length = 4
  op1 : (item T 79).length = 36
  vi1 : VarIntOf (encode ((item T 78).length : Int)) (item T 78).length
  sq1 : (item T 77).length = 4
  v0 : (item T 30).length = 8
  lk : VarIntOf (item T 0) (lkB T).length
  pt : item T 12 = [29, 2, 176, 23, 136, 118, 169, 20]
  pkh : (item T 66).length = 20
  pkh2 : ¬ decode (item T 65) = 0 → ((t1 :: t0 :: T)[67]?.getD []).length = 20
  v2 : (item T 64).length = 8
  p2 : (item T 63).length = 25
  lt : (item T 62).length = 4

/-- The version's width, from the run (fact 11). -/
theorem widthB_ver (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) (h12 : rebuildB_1_fact11 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) : (item T 136).length = 4 :=
  len_of_encode_eq h12

/-- The first input's varint, from the run (facts 3 and 9) and the width of the empty pushes: the length word the
rebuild measured, below the two-byte bound. -/
theorem widthB_vi0 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) (h3 : rebuildB_1_fact3 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (h9 : rebuildB_1_fact9 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (ha2 : a2.length = 150)
    (hhi : (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length := by
  have h46 : a2.length = 150 := ha2
  have h195 : (item T 120).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [h9]; decide)
  have hlo : 253 ≤ (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length := by
    simp only [scB0, List.length_append, List.length_cons] at *
    omega
  rw [rebuildB_1_fact3_eq] at h3
  exact varIntOf_num2bin3 h3 hlo hhi

/-- The second token input's varint, from the run (fact 2) and the width of the empty pushes, below the two-byte
bound. -/
theorem widthB_vi2 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) (h2 : rebuildB_1_fact2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (ha2 : a2.length = 150)
    (h107 : ¬ decode (item T 107) = 0) (hhi : (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length := by
  obtain ⟨hv, -, -, -, -, h167⟩ := rebuildB_1_fact2_parts t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 h2 h107
  have h46 : a2.length = 150 := ha2
  have h168 : ((t1 :: t0 :: T)[94]?.getD []).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [show (t1 :: t0 :: T)[94]?.getD [] = item T 92 from rfl, h167]; decide)
  have hlo : 253 ≤ (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length := by
    simp only [scB2, List.length_append, List.length_cons] at *
    omega
  exact varIntOf_num2bin3 hv hlo hhi

/-- **The second rebuild, parsed**: the bytes it hashes read as `gpTxB`. -/
theorem decode_rebuiltB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) (hw : WidthsB t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) :
    decodeTx (rebuiltB1 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) = some (gpTxB t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) := by
  have hin0 : ∀ r, readTxIn ((item T 135 ++ ((253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) ++
      (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 ++ item T 108))) ++ r) = some (inOfBytes (item T 135) (scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (item T 108), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op0 hw.vi0 hw.sq0
  have hin1 : ∀ r, readTxIn ((item T 79 ++ (encode ((item T 78).length : Int) ++ (item T 78 ++ item T 77))) ++ r) =
      some (inOfBytes (item T 79) (item T 78) (item T 77), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op1 hw.vi1 hw.sq1
  have hout0 : ∀ r, readTxOut ((item T 30 ++ (item T 0 ++ lkB T)) ++ r) = some (outOfBytes (item T 30) (lkB T), r) := by
    intro r; simp only [List.append_assoc]; exact readTxOut_bytes hw.v0 hw.lk
  have hl1 : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 66 ++ [136, 172])).length = 29 := by
    simp [hw.pkh]
  have hout1 : ∀ r, readTxOut ((item T 30 ++ (item T 12 ++ (item T 66 ++ [136, 172]))) ++ r) =
      some (outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 66 ++ [136, 172])), r) := by
    intro r
    rw [hw.pt]
    have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 66 ++ [136, 172])).length := by
      rw [hl1]; exact varIntOf_small (by decide)
    have h := readTxOut_bytes (r := r) hw.v0 hv
    simpa only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero] using h
  have hout3 : ∀ r, readTxOut ((item T 64 ++ ([25] ++ item T 63)) ++ r) = some (outOfBytes (item T 64) (item T 63), r) := by
    intro r; simp only [List.append_assoc]
    have hv : VarIntOf [25] (item T 63).length := by rw [hw.p2]; exact varIntOf_small (by decide)
    exact readTxOut_bytes hw.v2 hv
  by_cases h65 : decode (item T 65) = 0 <;> by_cases h107 : decode (item T 107) = 0
  · rw [rebuiltB1_00 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 h65 h107]
    simp only [gpTxB, h65, h107, ↓reduceIte, List.nil_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 2) (by decide)) (readsAs_cons hin0 (readsAs_one hin1))
      (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout3))) hw.lt
  · have hin2 : ∀ r, readTxIn (((t1 :: t0 :: T)[109]?.getD [] ++ ((253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) ++
        (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 ++ (t1 :: t0 :: T)[82]?.getD []))) ++ r) =
        some (inOfBytes ((t1 :: t0 :: T)[109]?.getD []) (scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) ((t1 :: t0 :: T)[82]?.getD []), r) := by
      intro r; simp only [List.append_assoc]; exact readTxIn_bytes (hw.op2 h107) (hw.vi2 h107) (hw.sq2 h107)
    rw [rebuiltB1_01 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 h65 h107]
    simp only [gpTxB, h65, h107, ↓reduceIte, List.nil_append, List.singleton_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 3) (by decide))
      (readsAs_cons hin0 (readsAs_cons hin2 (readsAs_one hin1)))
