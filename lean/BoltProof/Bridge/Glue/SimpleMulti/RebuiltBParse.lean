/-!
# The second rebuild's bytes, parsed

The second rebuild (suffix 2624–3739, a merge settle's) hashes the other lineage's grandparent, assembled from
the first piece set and the spend's own fields, and compares the hash with the token's `otherGrandparent`
(`rebuildB_1_fact1`). This file is `Rebuilt.lean` for those bytes: the layout for each optional arm
(`rebuiltB1_00` … `rebuiltB1_11`, the flags at items 63 and 103), the two unlocking scripts (`scB0`, `scB2`), the
token's lock (`lkB`, items 65–73 with the spend's issuer push and suffix), the parsed transaction (`gpTxB`) and
its widths (`WidthsB`), and the parse (`decode_rebuiltB`). The first rebuild's key literal and 144 empty pushes
are here the alt-stack items `a1` and `a2` it left. Generated by the glue's `gen_rebuiltB_parse.py`; regenerate
rather than edit.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Numbers BsvScript.Tx BsvScript.Sighash
open BoltProof.Glue.Serial

/-- The unlocking script the second rebuild assembles for the other grandparent's first input: the 144 empty
pushes (`a2`), the spend's own arguments, its preimage with the settled token's lock, the key tail (`a1`). -/
def scB0 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) : Bytes :=
  a2 ++ optPush (encode 4) ((item T 129)) ++ optPush (encode 4) ((item T 128)) ++ optPush [20] ((item T 127)) ++ optPush [36] ((item T 126)) ++ optPush [36] ((item T 125)) ++ 36 :: (item T 124) ++ 34 :: (item T 123) ++ optPush [20] ((item T 122)) ++ optPush [20] ((item T 121)) ++ optPush (encode 16) ((item T 120)) ++ optPush [1] ((item T 119)) ++ optPush [1] ((item T 118)) ++ (encode ((List.length ((item T 117)) : Nat) : Int) ++ (item T 117)) ++ optPush [33] ((item T 116)) ++ 76 :: (List.take (((List.length w19 : Nat) : Int) - 1).toNat w19 ++ (item T 115) ++ 3 :: 253 :: (w18 ++ [2, 173, 104] ++ 77 :: (w16 ++ 16 :: ((item T 114) ++ 16 :: (item T 113) ++ 20 :: (item T 112) ++ 20 :: (item T 111) ++ 20 :: (item T 110) ++ 36 :: (item T 109) ++ 1 :: (item T 108) ++ 36 :: (item T 107) ++ 36 :: (item T 106) ++ (item T 15) ++ (item T 14))))) ++ (encode ((List.length ((item T 105)) : Nat) : Int) ++ (item T 105)) ++ 3 :: 253 :: w17 ++ a1

theorem rebuildB_1_fact3_eq (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) :
    rebuildB_1_fact3 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 = (num2bin (encode ((scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length : Int)) (decode (encode 3)).toNat = some w15) := rfl

/-- The unlocking script of the other grandparent's optional second token input, from the pieces at depths 78–102. -/
def scB2 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) : Bytes :=
  a2 ++ optPush (encode 4) ((t1 :: t0 :: T)[104]?.getD []) ++ optPush (encode 4) ((t1 :: t0 :: T)[103]?.getD []) ++ optPush [20] ((t1 :: t0 :: T)[102]?.getD []) ++ optPush [36] ((t1 :: t0 :: T)[101]?.getD []) ++ optPush [36] ((t1 :: t0 :: T)[100]?.getD []) ++ 36 :: (t1 :: t0 :: T)[99]?.getD [] ++ 34 :: (t1 :: t0 :: T)[98]?.getD [] ++ optPush [20] ((t1 :: t0 :: T)[97]?.getD []) ++ optPush [20] ((t1 :: t0 :: T)[96]?.getD []) ++ optPush (encode 16) ((t1 :: t0 :: T)[95]?.getD []) ++ optPush [1] ((t1 :: t0 :: T)[94]?.getD []) ++ optPush [1] ((t1 :: t0 :: T)[93]?.getD []) ++ (encode ((((t1 :: t0 :: T)[92]?.getD []).length : Nat) : Int) ++ (t1 :: t0 :: T)[92]?.getD []) ++ optPush [33] ((t1 :: t0 :: T)[91]?.getD []) ++ 76 :: (List.take (((List.length w8 : Nat) : Int) - 1).toNat w8 ++ (t1 :: t0 :: T)[90]?.getD [] ++ 3 :: 253 :: (w9 ++ [2, 173, 104] ++ 77 :: (w11 ++ 16 :: ((t1 :: t0 :: T)[89]?.getD [] ++ 16 :: (t1 :: t0 :: T)[88]?.getD [] ++ 20 :: (t1 :: t0 :: T)[87]?.getD [] ++ 20 :: (t1 :: t0 :: T)[86]?.getD [] ++ 20 :: (t1 :: t0 :: T)[85]?.getD [] ++ 36 :: (t1 :: t0 :: T)[84]?.getD [] ++ 1 :: (t1 :: t0 :: T)[83]?.getD [] ++ 36 :: (t1 :: t0 :: T)[82]?.getD [] ++ 36 :: (t1 :: t0 :: T)[81]?.getD [] ++ (t1 :: t0 :: T)[17]?.getD [] ++ (t1 :: t0 :: T)[16]?.getD [])))) ++ (encode ((((t1 :: t0 :: T)[80]?.getD []).length : Nat) : Int) ++ (t1 :: t0 :: T)[80]?.getD []) ++ 3 :: 253 :: w10 ++ a1

/-- The second token input's facts the parse needs (fact 2, under its flag): the script's length word, the
length words inside it, the widths of its preimage push and key push. -/
theorem rebuildB_1_fact2_parts (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) (h2 : rebuildB_1_fact2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19)
    (h103 : ¬ decode (item T 103) = 0) :
    num2bin (encode ((scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length : Int)) (decode (encode 3)).toNat = some w12 ∧
      w11.length = 2 ∧ w10.length = 2 ∧ w9.length = 2 ∧ w8.length = 2 ∧
      encode (((item T 88).length : Nat) : Int) = [104] := by
  have h := h2 (by simp only [h103, ↓reduceIte, castToBool_encode_one])
  obtain ⟨h1, -, h3, h4, h5, h6, h7, -⟩ := h
  refine ⟨h1, ?_, ?_, ?_, ?_, h7⟩
  · rw [num2bin_length _ _ _ h3]; decide
  · rw [num2bin_length _ _ _ h4]; decide
  · rw [num2bin_length _ _ _ h5]; decide
  · rw [num2bin_length _ _ _ h6]; decide

/-- The commit token's lock in the rebuilt other grandparent: the pieces at depths 65–73, then the spend's own
issuer push and suffix. -/
def lkB (T : List Bytes) : Bytes :=
  16 :: (item T 73) ++ 16 :: (item T 72) ++ 20 :: (item T 71) ++ 20 :: (item T 70) ++ 20 :: (item T 69) ++
    36 :: (item T 68) ++ 1 :: (item T 67) ++ 36 :: (item T 66) ++
    36 :: (item T 65) ++ (item T 15) ++ (item T 14)

