/-- The rebuilt other grandparent as `decodeTx` reads it: the second token input and the second proof output present
when their flags are. -/
def gpTxB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) : Tx :=
  { version := toInt32 (leNat (item T 131)),
    inputs := inOfBytes (item T 130) (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) (item T 104) ::
      ((if decode (item T 103) = 0 then [] else
        [inOfBytes ((t1 :: t0 :: T)[105]?.getD []) (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) ((t1 :: t0 :: T)[79]?.getD [])]) ++
        [inOfBytes (item T 76) (item T 75) (item T 74)]),
    outputs := outOfBytes (item T 29) (lkB T) ::
      outOfBytes (item T 29) ((item T 12).drop 1 ++ (item T 64 ++ [136, 172])) ::
      ((if decode (item T 63) = 0 then [] else
        [outOfBytes ((t1 :: t0 :: T)[31]?.getD []) (((t1 :: t0 :: T)[14]?.getD []).drop 1 ++ ((t1 :: t0 :: T)[65]?.getD [] ++ [136, 172]))]) ++
        [outOfBytes (item T 62) (item T 61)]),
    lockTime := leNat (item T 60) }

/-- The widths the parse of the rebuilt other grandparent reads. -/
structure WidthsB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) : Prop where
  ver : (item T 131).length = 4
  op0 : (item T 130).length = 36
  vi0 : VarIntOf (253 :: List.take (((List.length w15 : Nat) : Int) - 1).toNat w15) (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length
  sq0 : (item T 104).length = 4
  op2 : ¬ decode (item T 103) = 0 → ((t1 :: t0 :: T)[105]?.getD []).length = 36
  vi2 : ¬ decode (item T 103) = 0 →
    VarIntOf (253 :: List.take (((List.length w12 : Nat) : Int) - 1).toNat w12) (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length
  sq2 : ¬ decode (item T 103) = 0 → ((t1 :: t0 :: T)[79]?.getD []).length = 4
  op1 : (item T 76).length = 36
  vi1 : VarIntOf (encode ((item T 75).length : Int)) (item T 75).length
  sq1 : (item T 74).length = 4
  v0 : (item T 29).length = 8
  lk : VarIntOf (item T 0) (lkB T).length
  pt : item T 12 = [29, 2, 176, 23, 136, 118, 169, 20]
  pkh : (item T 64).length = 20
  pkh2 : ¬ decode (item T 63) = 0 → ((t1 :: t0 :: T)[65]?.getD []).length = 20
  v2 : (item T 62).length = 8
  p2 : (item T 61).length = 25
  lt : (item T 60).length = 4

/-- The version's width, from the run (fact 11). -/
theorem widthB_ver (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) (h12 : rebuildB_1_fact11 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) : (item T 131).length = 4 :=
  len_of_encode_eq h12

/-- The first input's varint, from the run (facts 3 and 9) and the width of the empty pushes: the length word the
rebuild measured, below the two-byte bound. -/
theorem widthB_vi0 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) (h3 : rebuildB_1_fact3 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) (h9 : rebuildB_1_fact9 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) (ha2 : a2.length = 144)
    (hhi : (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w15 : Nat) : Int) - 1).toNat w15) (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length := by
  have h46 : a2.length = 144 := ha2
  have h195 : (item T 115).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [h9]; decide)
  have hlo : 253 ≤ (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length := by
    simp only [scB0, List.length_append, List.length_cons] at *
    omega
  rw [rebuildB_1_fact3_eq] at h3
  exact varIntOf_num2bin3 h3 hlo hhi

/-- The second token input's varint, from the run (fact 2) and the width of the empty pushes, below the two-byte
bound. -/
theorem widthB_vi2 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) (h2 : rebuildB_1_fact2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) (ha2 : a2.length = 144)
    (h103 : ¬ decode (item T 103) = 0) (hhi : (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w12 : Nat) : Int) - 1).toNat w12) (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length := by
  obtain ⟨hv, -, -, -, -, h167⟩ := rebuildB_1_fact2_parts t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 h2 h103
  have h46 : a2.length = 144 := ha2
  have h168 : ((t1 :: t0 :: T)[90]?.getD []).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [show (t1 :: t0 :: T)[90]?.getD [] = item T 88 from rfl, h167]; decide)
  have hlo : 253 ≤ (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19).length := by
    simp only [scB2, List.length_append, List.length_cons] at *
    omega
  exact varIntOf_num2bin3 hv hlo hhi

/-- **The second rebuild, parsed**: the bytes it hashes read as `gpTxB`. -/
theorem decode_rebuiltB (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 : Bytes) (hw : WidthsB t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) :
    decodeTx (rebuiltB1 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) = some (gpTxB t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) := by
  have hin0 : ∀ r, readTxIn ((item T 130 ++ ((253 :: List.take (((List.length w15 : Nat) : Int) - 1).toNat w15) ++
      (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 ++ item T 104))) ++ r) = some (inOfBytes (item T 130) (scB0 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) (item T 104), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op0 hw.vi0 hw.sq0
  have hin1 : ∀ r, readTxIn ((item T 76 ++ (encode ((item T 75).length : Int) ++ (item T 75 ++ item T 74))) ++ r) =
      some (inOfBytes (item T 76) (item T 75) (item T 74), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op1 hw.vi1 hw.sq1
  have hout0 : ∀ r, readTxOut ((item T 29 ++ (item T 0 ++ lkB T)) ++ r) = some (outOfBytes (item T 29) (lkB T), r) := by
    intro r; simp only [List.append_assoc]; exact readTxOut_bytes hw.v0 hw.lk
  have hl1 : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 64 ++ [136, 172])).length = 29 := by
    simp [hw.pkh]
  have hout1 : ∀ r, readTxOut ((item T 29 ++ (item T 12 ++ (item T 64 ++ [136, 172]))) ++ r) =
      some (outOfBytes (item T 29) ((item T 12).drop 1 ++ (item T 64 ++ [136, 172])), r) := by
    intro r
    rw [hw.pt]
    have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 64 ++ [136, 172])).length := by
      rw [hl1]; exact varIntOf_small (by decide)
    have h := readTxOut_bytes (r := r) hw.v0 hv
    simpa only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero] using h
  have hout3 : ∀ r, readTxOut ((item T 62 ++ ([25] ++ item T 61)) ++ r) = some (outOfBytes (item T 62) (item T 61), r) := by
    intro r; simp only [List.append_assoc]
    have hv : VarIntOf [25] (item T 61).length := by rw [hw.p2]; exact varIntOf_small (by decide)
    exact readTxOut_bytes hw.v2 hv
  by_cases h63 : decode (item T 63) = 0 <;> by_cases h103 : decode (item T 103) = 0
  · rw [rebuiltB1_00 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 h63 h103]
    simp only [gpTxB, h63, h103, ↓reduceIte, List.nil_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 2) (by decide)) (readsAs_cons hin0 (readsAs_one hin1))
      (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout3))) hw.lt
  · have hin2 : ∀ r, readTxIn (((t1 :: t0 :: T)[105]?.getD [] ++ ((253 :: List.take (((List.length w12 : Nat) : Int) - 1).toNat w12) ++
        (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 ++ (t1 :: t0 :: T)[79]?.getD []))) ++ r) =
        some (inOfBytes ((t1 :: t0 :: T)[105]?.getD []) (scB2 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19) ((t1 :: t0 :: T)[79]?.getD []), r) := by
      intro r; simp only [List.append_assoc]; exact readTxIn_bytes (hw.op2 h103) (hw.vi2 h103) (hw.sq2 h103)
    rw [rebuiltB1_01 t1 t0 a1 a2 T w8 w9 w10 w11 w12 w15 w16 w17 w18 w19 h63 h103]
    simp only [gpTxB, h63, h103, ↓reduceIte, List.nil_append, List.singleton_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 3) (by decide))
      (readsAs_cons hin0 (readsAs_cons hin2 (readsAs_one hin1)))
      (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout3))) hw.lt
  · have hout2 : ∀ r, readTxOut (((t1 :: t0 :: T)[31]?.getD [] ++ ((t1 :: t0 :: T)[14]?.getD [] ++ ((t1 :: t0 :: T)[65]?.getD [] ++ [136, 172]))) ++ r) =
        some (outOfBytes ((t1 :: t0 :: T)[31]?.getD []) (((t1 :: t0 :: T)[14]?.getD []).drop 1 ++ ((t1 :: t0 :: T)[65]?.getD [] ++ [136, 172])), r) := by
