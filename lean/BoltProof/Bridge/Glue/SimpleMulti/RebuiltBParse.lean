import BoltProof.Bridge.Glue.SimpleMulti.Rebuilt
import BoltProof.Bridge.Glue.SimpleMulti.RebuiltB

/-!
# The second rebuild's bytes, parsed

The second rebuild (suffix 2715–3896, a merge settle's) hashes the other lineage's grandparent, assembled from
the first piece set and the spend's own fields, and compares the hash with the token's `otherGrandparent`
(`rebuildB_k_fact1`). This file is `Rebuilt.lean` for those bytes: the layout for each optional arm
(`rebuiltB1_00` … `rebuiltB1_11`, the flags at items 65 and 107), the two unlocking scripts (`scB0`, `scB2`), the
token's lock (`lkB`, items 67–76 with the spend's issuer push and suffix), the parsed transaction (`gpTxB`) and
its widths (`WidthsB`), and the parse (`decode_rebuiltB`). The first rebuild's key literal and 150 empty pushes
are here the alt-stack items `a1` and `a2` it left. Both cases of the second rebuild have these bytes up to the
width variables' names (`rebuiltB2_eq`). Generated by the glue's `gen_rebuiltB_parse.py`; regenerate rather
than edit.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Numbers BsvScript.Tx BsvScript.Sighash
open BoltProof.Glue.Serial

/-- The unlocking script the second rebuild assembles for the other grandparent's first input: the 150 empty
pushes (`a2`), the spend's own arguments, its preimage with the settled token's lock, the key tail (`a1`). -/
def scB0 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) : Bytes :=
  a2 ++ optPush (encode 4) ((item T 134)) ++ optPush (encode 4) ((item T 133)) ++ optPush [20] ((item T 132)) ++ optPush [36] ((item T 131)) ++ optPush [36] ((item T 130)) ++ 36 :: (item T 129) ++ 34 :: (item T 128) ++ optPush [20] ((item T 127)) ++ optPush [20] ((item T 126)) ++ optPush (encode 16) ((item T 125)) ++ optPush [1] ((item T 124)) ++ optPush [1] ((item T 123)) ++ (encode ((List.length ((item T 122)) : Nat) : Int) ++ (item T 122)) ++ optPush [33] ((item T 121)) ++ 76 :: (List.take (((List.length w23 : Nat) : Int) - 1).toNat w23 ++ (item T 120) ++ 3 :: 253 :: (w20 ++ [2, 173, 104] ++ 77 :: (w18 ++ 16 :: ((item T 119) ++ 16 :: (item T 118) ++ 20 :: (item T 117) ++ 20 :: (item T 116) ++ 20 :: (item T 115) ++ 36 :: (item T 114) ++ 1 :: (item T 113) ++ optPush [1] ((item T 112)) ++ 36 :: (item T 111) ++ 36 :: (item T 110) ++ (item T 15) ++ (item T 14))))) ++ (encode ((List.length ((item T 109)) : Nat) : Int) ++ (item T 109)) ++ 3 :: 253 :: w19 ++ a1

theorem rebuildB_1_fact3_eq (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) :
    rebuildB_1_fact3 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 = (num2bin (encode ((scB0 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length : Int)) (decode (encode 3)).toNat = some w17) := rfl

/-- The unlocking script of the other grandparent's optional second token input, from the pieces at depths 81–106. -/
def scB2 (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) : Bytes :=
  a2 ++ optPush (encode 4) ((t1 :: t0 :: T)[108]?.getD []) ++ optPush (encode 4) ((t1 :: t0 :: T)[107]?.getD []) ++ optPush [20] ((t1 :: t0 :: T)[106]?.getD []) ++ optPush [36] ((t1 :: t0 :: T)[105]?.getD []) ++ optPush [36] ((t1 :: t0 :: T)[104]?.getD []) ++ 36 :: (t1 :: t0 :: T)[103]?.getD [] ++ 34 :: (t1 :: t0 :: T)[102]?.getD [] ++ optPush [20] ((t1 :: t0 :: T)[101]?.getD []) ++ optPush [20] ((t1 :: t0 :: T)[100]?.getD []) ++ optPush (encode 16) ((t1 :: t0 :: T)[99]?.getD []) ++ optPush [1] ((t1 :: t0 :: T)[98]?.getD []) ++ optPush [1] ((t1 :: t0 :: T)[97]?.getD []) ++ (encode ((((t1 :: t0 :: T)[96]?.getD []).length : Nat) : Int) ++ (t1 :: t0 :: T)[96]?.getD []) ++ optPush [33] ((t1 :: t0 :: T)[95]?.getD []) ++ 76 :: (List.take (((List.length w10 : Nat) : Int) - 1).toNat w10 ++ (t1 :: t0 :: T)[94]?.getD [] ++ 3 :: 253 :: (w11 ++ [2, 173, 104] ++ 77 :: (w13 ++ 16 :: ((t1 :: t0 :: T)[93]?.getD [] ++ 16 :: (t1 :: t0 :: T)[92]?.getD [] ++ 20 :: (t1 :: t0 :: T)[91]?.getD [] ++ 20 :: (t1 :: t0 :: T)[90]?.getD [] ++ 20 :: (t1 :: t0 :: T)[89]?.getD [] ++ 36 :: (t1 :: t0 :: T)[88]?.getD [] ++ 1 :: (t1 :: t0 :: T)[87]?.getD [] ++ optPush [1] ((t1 :: t0 :: T)[86]?.getD []) ++ 36 :: (t1 :: t0 :: T)[85]?.getD [] ++ 36 :: (t1 :: t0 :: T)[84]?.getD [] ++ (t1 :: t0 :: T)[17]?.getD [] ++ (t1 :: t0 :: T)[16]?.getD [])))) ++ (encode ((((t1 :: t0 :: T)[83]?.getD []).length : Nat) : Int) ++ (t1 :: t0 :: T)[83]?.getD []) ++ 3 :: 253 :: w12 ++ a1

/-- The second token input's facts the parse needs (fact 2, under its flag): the script's length word, the
length words inside it, the widths of its preimage push and key push. -/
theorem rebuildB_1_fact2_parts (t1 t0 a1 a2 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes) (h2 : rebuildB_1_fact2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23)
    (h107 : ¬ decode (item T 107) = 0) :
    num2bin (encode ((scB2 t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).length : Int)) (decode (encode 3)).toNat = some w14 ∧
      w13.length = 2 ∧ w12.length = 2 ∧ w11.length = 2 ∧ w10.length = 2 ∧
      encode (((item T 92).length : Nat) : Int) = [104] := by
  have h := h2 (by simp only [h107, ↓reduceIte, castToBool_encode_one])
  obtain ⟨h1, -, h3, h4, h5, h6, h7, -⟩ := h
  refine ⟨h1, ?_, ?_, ?_, ?_, h7⟩
  · rw [num2bin_length _ _ _ h3]; decide
  · rw [num2bin_length _ _ _ h4]; decide
  · rw [num2bin_length _ _ _ h5]; decide
  · rw [num2bin_length _ _ _ h6]; decide

/-- The commit token's lock in the rebuilt other grandparent: the pieces at depths 67–76, then the spend's own
issuer push and suffix. -/
def lkB (T : List Bytes) : Bytes :=
  16 :: (item T 76) ++ 16 :: (item T 75) ++ 20 :: (item T 74) ++ 20 :: (item T 73) ++ 20 :: (item T 72) ++
    36 :: (item T 71) ++ 1 :: (item T 70) ++ optPush [1] ((item T 69)) ++ 36 :: (item T 68) ++
    36 :: (item T 67) ++ (item T 15) ++ (item T 14)

