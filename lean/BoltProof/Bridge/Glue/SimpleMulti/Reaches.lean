/-! ## The prologue -/

/-- The issuer guard's condition, as the prologue leaves it on the stack. -/
abbrev guardFlag (f : Fields) : Bytes := encode (if decode f.parent = 0 ∨ decode f.gp = 0 then 1 else 0)
/-- Whether the token has a grandparent, as the prologue leaves it on the stack. -/
abbrev hasGpFlag (f : Fields) : Bytes := encode (if decode f.gp = 0 then 0 else 1)

/-- The stack at suffix 38, inside the `OP_IFDUP OP_IF` arm, with a preimage. -/
abbrev stack38 (f : Fields) (a : Args) (S : List Bytes) : List Bytes :=
  a.pre :: hasGpFlag f :: f.gp :: guardFlag f :: f.parent :: f.outIdx :: f.ty :: f.ogp :: f.com2 :: f.com ::
    f.pkh :: f.balCommit :: f.bal :: a.pre :: a.pk :: a.sig :: a.inIdx :: a.nty :: a.nbc :: a.pkh2 :: a.pkh1 ::
    a.chg :: a.fund :: a.i1 :: a.i2 :: a.i3 :: a.i4 :: a.i5 :: (a.psA.stack ++ (a.psB.stack ++ S))

/-- The bound the balance checks compare against: `2^127 - 1`, little-endian. -/
abbrev maxBalanceBytes : Bytes := [255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127]

/-- `OP_EQUAL OP_NOT OP_VERIFY` on a byte string, as a proposition. -/
theorem decode_ite_one_nil_eq_zero (c : Prop) [Decidable c] : decode (if c then [1] else []) = 0 ↔ ¬ c := by
  split_ifs with hc <;> simp [hc, decode_lit 1 (by decide), decode_nil]

/-- The prologue (suffix 0–37): under the issuer guard (`parent = 0 ∨ gp = 0`) the signer is the
issuer and the next type is neither `0x25` nor `0x27`; with a preimage, the run enters the
`OP_IFDUP OP_IF` arm with the stack `stack38`. -/
theorem prologue {env : Env} (he : EnvOK env) {k t : Bytes} {r : GOut} {f : Fields} {a : Args}
    {S A : List Bytes} {C : Cond} {cs : Bytes} {m kk : Nat} (hact : C.isActive = true)
    (hpre : castToBool a.pre = true)
    (h : run Eval.opExec env (SimpleMulti.suffix ++ k) t (St (f.stack ++ (a.stack ++ S)) A m C kk cs) = r)
    (hr : r.IsOk) :
    ((decode f.parent = 0 ∨ decode f.gp = 0) → f.issuer = a.pk ∧ a.nty ≠ [0x25] ∧ a.nty ≠ [0x27]) ∧
      ∃ m' k', run Eval.opExec env (SimpleMulti.suffix.drop 38 ++ k) t
        (St (stack38 f a S) A m' (C.opIf true) k' cs) = r := by
  simp only [SimpleMulti.suffix, Fields.stack, Args.stack, SimpleMulti.c0, SimpleMulti.c10_if, SimpleMulti.c11, SimpleMulti.c27_else, SimpleMulti.c28, SimpleMulti.c29_endif, SimpleMulti.c30, SimpleMulti.c37_if, List.cons_append,
    List.nil_append, List.append_assoc] at h
  rw [suffix_drop_38_append]
  by_cases hpar : decode f.parent = 0 <;> by_cases hgp : decode f.gp = 0
  all_goals (sym_all h hpar hgp hpre)
  all_goals (simp (config := { failIfUnchanged := false }) only [castToBool_encode_ite, decide_eq_true_eq,
    decode_ite_one_nil_eq_zero] at *)
  all_goals (simp only [stack38, guardFlag, hasGpFlag, hpar, hgp, true_or, or_true, or_false, false_or, ↓reduceIte,
    encode_one, encode_zero])
  · exact ⟨fun _ => ⟨‹_›, ‹_›, ‹_›⟩, _, _, h⟩
  · exact ⟨fun _ => ⟨‹_›, ‹_›, ‹_›⟩, _, _, h⟩
  · exact ⟨fun _ => ⟨‹_›, ‹_›, ‹_›⟩, _, _, h⟩
  · exact ⟨fun hg => by first | exact hg.elim | exact hg.elim (fun h0 => absurd h0 hpar) (fun h0 => absurd h0 hgp),
      _, _, h⟩

/-! ## The fragments -/

/-- The parity check (`Gadgets/Parity.lean`, suffix 528) is reached with the spent type at depth 26 and the next type at depth 37. -/
theorem reaches_parityCheck {env : Env} (he : EnvOK env) {k t : Bytes} {r : GOut} {f : Fields} {a : Args}
    {S A : List Bytes} {C : Cond} {cs : Bytes} {m kk : Nat} (hact : C.isActive = true)
    (hpre : castToBool a.pre = true) (hvar : List.take 1 (List.drop 104 a.pre) = [0xfd])
    (h : run Eval.opExec env (SimpleMulti.suffix ++ k) t (St (f.stack ++ (a.stack ++ S)) A m C kk cs) = r)
    (hr : r.IsOk) :
    Reaches env 528 k t r cs (fun S => S.getD 26 [] = f.ty ∧ S.getD 37 [] = a.nty ∧ 37 < S.length) := by
  obtain ⟨-, m', k', h⟩ := prologue he hact hpre h hr
  rw [suffix_drop_38_append, pushTxBlock_eq] at h
  have hact' : (C.opIf true).isActive = true := by simp [hact]
  replace h := pushTx_shape he hact' h hr
  obtain ⟨_, _, h⟩ := h
  simp only [stack38, Pieces75.stack, SimpleMulti.c423, SimpleMulti.c441_if, SimpleMulti.c442, SimpleMulti.c446_else, SimpleMulti.c447, SimpleMulti.c451_if, SimpleMulti.c452, SimpleMulti.c456_else, SimpleMulti.c457, SimpleMulti.c461_if, SimpleMulti.c462, SimpleMulti.c466_else, SimpleMulti.c467, SimpleMulti.c470_endif, SimpleMulti.c471_endif, SimpleMulti.c472_endif, SimpleMulti.c473, List.cons_append, List.nil_append] at h
  sym_all h hvar 
  refine ⟨?S, ?A, ?m, ?C, ?kk, ?run, ?act, ?P⟩
  case run =>
    rw [suffix_drop_528_append]
    exact h
  case act => simp [hact]
  case P => exact ⟨rfl, rfl, by simp only [List.length_cons]; omega⟩
