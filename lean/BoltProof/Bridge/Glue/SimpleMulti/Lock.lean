import BoltProof.Bridge.Glue.SimpleMulti.Spec

/-!
# The `SimpleMultiBOLT` lock

The locking script is the eleven field pushes followed by the suffix (`lockScript`); `WF` is the widths the pushes
carry (16 + 16 + 20 + 20 + 20 + 36 + 1 + 1 + 36 + 36 + 33 bytes of data, 246 bytes with the push opcodes), `decodeLock`
reads the fields back (`decodeLock_lockScript`), and `lock_pushes` runs the pushes symbolically, so a run of the
whole lock is a run of the suffix from `Fields.stack`. Generated by the glue's `gen_abs.py`; regenerate rather
than edit.
-/

set_option autoImplicit false

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Params BsvScript.Numbers BsvScript.Machine BsvScript.Gadget
open BoltProof.Bridge.Generated

/-- Well-formed lock fields: the widths the eleven pushes carry. -/
structure WF (f : Fields) : Prop where
  bal : f.bal.length = 16
  balCommit : f.balCommit.length = 16
  pkh : f.pkh.length = 20
  com : f.com.length = 20
  com2 : f.com2.length = 20
  ogp : f.ogp.length = 36
  ty : f.ty.length = 1
  outIdx : f.outIdx.length = 1
  parent : f.parent.length = 36
  gp : f.gp.length = 36
  issuer : f.issuer.length = 33

/-- The locking script: the eleven pushes, `bal` first and `issuer` last, then the suffix. -/
def lockScript (f : Fields) : Bytes :=
  16 :: (f.bal ++ 16 :: (f.balCommit ++ 20 :: (f.pkh ++ 20 :: (f.com ++ 20 :: (f.com2 ++ 36 :: (f.ogp ++ 1 :: (f.ty ++ 1 :: (f.outIdx ++ 36 :: (f.parent ++ 36 :: (f.gp ++ 33 :: (f.issuer ++ SimpleMulti.suffix)))))))))))

theorem lockScript_length {f : Fields} (hwf : WF f) : (lockScript f).length = 246 + SimpleMulti.suffix.length := by
  simp [lockScript, hwf.bal, hwf.balCommit, hwf.pkh, hwf.com, hwf.com2, hwf.ogp, hwf.ty, hwf.outIdx, hwf.parent, hwf.gp, hwf.issuer]; omega

/-- The eleven pushes put the fields on the stack, `issuer` on top: a run of the lock is a run of the suffix
from `Fields.stack`. -/
theorem lock_pushes {env : Env} (he : EnvOK env) {t : Bytes} {r : GOut} {f : Fields} {S A : List Bytes}
    {C : Cond} {cs : Bytes} {m kk : Nat} (hact : C.isActive = true) (hwf : WF f)
    (h : run Eval.opExec env (lockScript f) t (St S A m C kk cs) = r) (hr : r.IsOk) :
    ∃ m' k', run Eval.opExec env SimpleMulti.suffix t (St (f.stack ++ S) A m' C k' cs) = r := by
  unfold lockScript at h
  obtain ⟨-, _, _, h⟩ := inv_push_16 he hact h hr
  rw [List.take_left' hwf.bal, List.drop_left' hwf.bal] at h
  obtain ⟨-, _, _, h⟩ := inv_push_16 he hact h hr
  rw [List.take_left' hwf.balCommit, List.drop_left' hwf.balCommit] at h
  obtain ⟨-, _, _, h⟩ := inv_push_20 he hact h hr
  rw [List.take_left' hwf.pkh, List.drop_left' hwf.pkh] at h
  obtain ⟨-, _, _, h⟩ := inv_push_20 he hact h hr
  rw [List.take_left' hwf.com, List.drop_left' hwf.com] at h
  obtain ⟨-, _, _, h⟩ := inv_push_20 he hact h hr
  rw [List.take_left' hwf.com2, List.drop_left' hwf.com2] at h
  obtain ⟨-, _, _, h⟩ := inv_push_36 he hact h hr
  rw [List.take_left' hwf.ogp, List.drop_left' hwf.ogp] at h
  obtain ⟨-, _, _, h⟩ := inv_push_1 he hact h hr
  rw [List.take_left' hwf.ty, List.drop_left' hwf.ty] at h
  obtain ⟨-, _, _, h⟩ := inv_push_1 he hact h hr
  rw [List.take_left' hwf.outIdx, List.drop_left' hwf.outIdx] at h
  obtain ⟨-, _, _, h⟩ := inv_push_36 he hact h hr
  rw [List.take_left' hwf.parent, List.drop_left' hwf.parent] at h
  obtain ⟨-, _, _, h⟩ := inv_push_36 he hact h hr
  rw [List.take_left' hwf.gp, List.drop_left' hwf.gp] at h
  obtain ⟨-, _, _, h⟩ := inv_push_33 he hact h hr
  rw [List.take_left' hwf.issuer, List.drop_left' hwf.issuer] at h
  exact ⟨_, _, h⟩

/-- The fields read back off a locking script: the push opcodes at their places, the suffix after them,
nothing else. -/
def decodeLock (s : Bytes) : Option Fields :=
  if s.length = 246 + SimpleMulti.suffix.length ∧ s[0]? = some 16 ∧ s[17]? = some 16 ∧ s[34]? = some 20 ∧ s[55]? = some 20 ∧ s[76]? = some 20 ∧ s[97]? = some 36 ∧ s[134]? = some 1 ∧ s[136]? = some 1 ∧ s[138]? = some 36 ∧ s[175]? = some 36 ∧ s[212]? = some 33 ∧ s.drop 246 = SimpleMulti.suffix then
    some { bal := (s.drop 1).take 16, balCommit := (s.drop 18).take 16, pkh := (s.drop 35).take 20, com := (s.drop 56).take 20, com2 := (s.drop 77).take 20, ogp := (s.drop 98).take 36, ty := (s.drop 135).take 1, outIdx := (s.drop 137).take 1, parent := (s.drop 139).take 36, gp := (s.drop 176).take 36, issuer := (s.drop 213).take 33 }
  else none

/-! The lock's layout: what sits at each push and after it, for the decoder and for the welds. -/

