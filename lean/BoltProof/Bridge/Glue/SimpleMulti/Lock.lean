theorem lockScript_drop_210 {f : Fields} (hwf : WF f) : (lockScript f).drop 210 =
    33 :: (f.issuer ++ SimpleMulti.suffix) := by
  rw [show (210 : Nat) = 174 + 36 from rfl, ← List.drop_drop, lockScript_drop_174 hwf, List.drop_left' hwf.gp]
theorem lockScript_drop_211 {f : Fields} (hwf : WF f) : (lockScript f).drop 211 =
    f.issuer ++ SimpleMulti.suffix := by
  rw [show (211 : Nat) = 210 + 1 from rfl, ← List.drop_drop, lockScript_drop_210 hwf]; rfl
theorem lockScript_drop_244 {f : Fields} (hwf : WF f) : (lockScript f).drop 244 = SimpleMulti.suffix := by
  rw [show (244 : Nat) = 211 + 33 from rfl, ← List.drop_drop, lockScript_drop_211 hwf, List.drop_left' hwf.issuer]

/-- A well-formed lock decodes to its fields. -/
theorem decodeLock_lockScript {f : Fields} (hwf : WF f) : decodeLock (lockScript f) = some f := by
  have g : ∀ (n : Nat) (b : Nat) (r : Bytes), (lockScript f).drop n = b :: r → (lockScript f)[n]? = some b := by
    intro n b r hn
    have := @List.getElem?_drop _ (lockScript f) n 0
    rw [Nat.add_zero] at this
    rw [← this, hn]; rfl
  unfold decodeLock
  rw [ite_eq_left ⟨lockScript_length hwf, rfl, g _ _ _ (lockScript_drop_17 hwf), g _ _ _ (lockScript_drop_34 hwf), g _ _ _ (lockScript_drop_55 hwf), g _ _ _ (lockScript_drop_76 hwf), g _ _ _ (lockScript_drop_97 hwf), g _ _ _ (lockScript_drop_134 hwf), g _ _ _ (lockScript_drop_136 hwf), g _ _ _ (lockScript_drop_173 hwf), g _ _ _ (lockScript_drop_210 hwf), lockScript_drop_244 hwf⟩]
  congr 1
  rw [lockScript_drop_1, lockScript_drop_18 hwf, lockScript_drop_35 hwf, lockScript_drop_56 hwf, lockScript_drop_77 hwf, lockScript_drop_98 hwf, lockScript_drop_135 hwf, lockScript_drop_137 hwf, lockScript_drop_174 hwf, lockScript_drop_211 hwf, List.take_left' hwf.bal, List.take_left' hwf.balCommit, List.take_left' hwf.pkh, List.take_left' hwf.com, List.take_left' hwf.com2, List.take_left' hwf.ogp, List.take_left' hwf.ty, List.take_left' hwf.parent, List.take_left' hwf.gp, List.take_left' hwf.issuer]

end BoltProof.Glue.SimpleMulti
