/-- A well-formed lock decodes to its fields. -/
theorem decodeLock_lockScript {f : Fields} (hwf : WF f) : decodeLock (lockScript f) = some f := by
  have g : ∀ (n : Nat) (b : Nat) (r : Bytes), (lockScript f).drop n = b :: r → (lockScript f)[n]? = some b := by
    intro n b r hn
    have := @List.getElem?_drop _ (lockScript f) n 0
    rw [Nat.add_zero] at this
    rw [← this, hn]; rfl
  unfold decodeLock
  rw [ite_eq_left ⟨lockScript_length hwf, rfl, g _ _ _ (lockScript_drop_17 hwf), g _ _ _ (lockScript_drop_34 hwf), g _ _ _ (lockScript_drop_55 hwf), g _ _ _ (lockScript_drop_76 hwf), g _ _ _ (lockScript_drop_97 hwf), g _ _ _ (lockScript_drop_134 hwf), g _ _ _ (lockScript_drop_136 hwf), g _ _ _ (lockScript_drop_138 hwf), g _ _ _ (lockScript_drop_175 hwf), g _ _ _ (lockScript_drop_212 hwf), lockScript_drop_246 hwf⟩]
  congr 1
  rw [lockScript_drop_1, lockScript_drop_18 hwf, lockScript_drop_35 hwf, lockScript_drop_56 hwf, lockScript_drop_77 hwf, lockScript_drop_98 hwf, lockScript_drop_135 hwf, lockScript_drop_137 hwf, lockScript_drop_139 hwf, lockScript_drop_176 hwf, lockScript_drop_213 hwf, List.take_left' hwf.bal, List.take_left' hwf.balCommit, List.take_left' hwf.pkh, List.take_left' hwf.com, List.take_left' hwf.com2, List.take_left' hwf.ogp, List.take_left' hwf.ty, List.take_left' hwf.outIdx, List.take_left' hwf.parent, List.take_left' hwf.gp, List.take_left' hwf.issuer]

end BoltProof.Glue.SimpleMulti
