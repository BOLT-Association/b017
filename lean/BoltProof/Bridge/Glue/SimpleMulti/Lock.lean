    f.bal ++ 16 :: (f.balCommit ++ 20 :: (f.pkh ++ 20 :: (f.com ++ 20 :: (f.com2 ++ 36 :: (f.ogp ++ 1 :: (f.ty ++ 1 :: (f.outIdx ++ 36 :: (f.parent ++ 36 :: (f.gp ++ 33 :: (f.issuer ++ SimpleMulti.suffix)))))))))) := rfl
