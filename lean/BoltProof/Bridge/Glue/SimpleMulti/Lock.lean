    f.parent ++ 36 :: (f.gp ++ 33 :: (f.issuer ++ SimpleMulti.suffix)) := by
  rw [show (137 : Nat) = 136 + 1 from rfl, ← List.drop_drop, lockScript_drop_136 hwf]; rfl
