    16 :: (f.balCommit ++ 20 :: (f.pkh ++ 20 :: (f.com ++ 20 :: (f.com2 ++ 36 :: (f.ogp ++ 1 :: (f.ty ++ 1 :: (f.outIdx ++ 36 :: (f.parent ++ 36 :: (f.gp ++ 33 :: (f.issuer ++ SimpleMulti.suffix)))))))))) := by
  rw [show (17 : Nat) = 1 + 16 from rfl, ← List.drop_drop, lockScript_drop_1, List.drop_left' hwf.bal]
