    36 :: (f.parent ++ 36 :: (f.gp ++ 33 :: (f.issuer ++ SimpleMulti.suffix))) := by
  rw [show (136 : Nat) = 135 + 1 from rfl, ← List.drop_drop, lockScript_drop_135 hwf, List.drop_left' hwf.ty]
