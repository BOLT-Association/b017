    rebuildA_fact3 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 = (num2bin (encode ((scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length : Int)) (decode (encode 3)).toNat = some w17) := rfl

/-- The commit token's lock in the rebuilt grandparent: the pieces at depths 142–151, then the spend's own
issuer push and suffix. -/
def lkA (T : List Bytes) : Bytes :=
  16 :: (item T 151) ++ 16 :: (item T 150) ++ 20 :: (item T 149) ++ 20 :: (item T 148) ++ 20 :: (item T 147) ++
    36 :: (item T 146) ++ 1 :: (item T 145) ++ optPush [1] ((item T 144)) ++ 36 :: (item T 143) ++
    36 :: (item T 142) ++ (item T 15) ++ (item T 14)

/-- The rebuilt grandparent with neither optional arm, field by field. -/
theorem rebuiltA_00 (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) (h140 : decode (item T 140) = 0) (h182 : decode (item T 182) = 0) :
    rebuiltA t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 =
      item T 211 ++ ([2] ++
        (((item T 210 ++ ((253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) ++ (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 ++ item T 183))) ++
          (item T 154 ++ (encode ((item T 153).length : Int) ++ (item T 153 ++ item T 152)))) ++
        ([3] ++
          (((item T 30 ++ (item T 0 ++ lkA T)) ++
            ((item T 30 ++ (item T 12 ++ (item T 141 ++ [136, 172]))) ++ (item T 139 ++ ([25] ++ item T 138)))) ++
          item T 137)))) := by
  simp only [rebuiltA, scA0, lkA, h140, h182, encode_zero, castToBool_nil, Bool.false_eq_true, ↓reduceIte,
    List.append_assoc, List.cons_append, List.nil_append, encode_two, encode_three]

/-- The rebuilt grandparent as `decodeTx` reads it, with neither optional arm. -/
def gpTxA0 (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) : Tx :=
  { version := toInt32 (leNat (item T 211)),
    inputs := [inOfBytes (item T 210) (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) (item T 183), inOfBytes (item T 154) (item T 153) (item T 152)],
    outputs := [outOfBytes (item T 30) (lkA T), outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 141 ++ [136, 172])),
      outOfBytes (item T 139) (item T 138)],
    lockTime := leNat (item T 137) }

/-- The widths the parse of the rebuilt grandparent reads, with neither optional arm. -/
structure WidthsA0 (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) : Prop where
  ver : (item T 211).length = 4
  op0 : (item T 210).length = 36
  vi0 : VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length
  sq0 : (item T 183).length = 4
  op1 : (item T 154).length = 36
  vi1 : VarIntOf (encode ((item T 153).length : Int)) (item T 153).length
  sq1 : (item T 152).length = 4
  v0 : (item T 30).length = 8
  lk : VarIntOf (item T 0) (lkA T).length
  pt : item T 12 = [29, 2, 176, 23, 136, 118, 169, 20]
  pkh : (item T 141).length = 20
  v2 : (item T 139).length = 8
  p2 : (item T 138).length = 25
  lt : (item T 137).length = 4

/-- The version's width, from the run (fact 12). -/
theorem widthA_ver (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) (h12 : rebuildA_fact12 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) : (item T 211).length = 4 :=
  len_of_encode_eq h12

/-- The first input's varint, from the run (facts 3, 9 and 11): the length word the rebuild measured, below
the two-byte bound. -/
theorem widthA_vi0 (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) (h3 : rebuildA_fact3 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) (h9 : rebuildA_fact9 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) (h11 : rebuildA_fact11 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46)
    (hhi : (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length := by
  have h46 : w46.length = 150 := by
    have := num2bin_length _ _ _ h11
    rw [this]; decide
  have h195 : (item T 195).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [h9]; decide)
  have hlo : 253 ≤ (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length := by
    simp only [scA0, List.length_append, List.length_cons] at *
    omega
  rw [rebuildA_fact3_eq] at h3
  exact varIntOf_num2bin3 h3 hlo hhi

/-- **The first rebuild, parsed** (neither optional arm): the bytes it hashes read as `gpTxA0`. -/
theorem decode_rebuiltA_00 (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) (h140 : decode (item T 140) = 0) (h182 : decode (item T 182) = 0)
    (hw : WidthsA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) :
    decodeTx (rebuiltA t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) = some (gpTxA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) := by
  rw [rebuiltA_00 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 h140 h182]
  have hin0 : ∀ r, readTxIn ((item T 210 ++ ((253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) ++
      (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 ++ item T 183))) ++ r) = some (inOfBytes (item T 210) (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) (item T 183), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op0 hw.vi0 hw.sq0
  have hin1 : ∀ r, readTxIn ((item T 154 ++ (encode ((item T 153).length : Int) ++ (item T 153 ++ item T 152))) ++ r) =
      some (inOfBytes (item T 154) (item T 153) (item T 152), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op1 hw.vi1 hw.sq1
  have hout0 : ∀ r, readTxOut ((item T 30 ++ (item T 0 ++ lkA T)) ++ r) = some (outOfBytes (item T 30) (lkA T), r) := by
    intro r; simp only [List.append_assoc]; exact readTxOut_bytes hw.v0 hw.lk
  have hout1 : ∀ r, readTxOut ((item T 30 ++ (item T 12 ++ (item T 141 ++ [136, 172]))) ++ r) =
      some (outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 141 ++ [136, 172])), r) := by
    intro r
    rw [hw.pt]
    have hl : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 141 ++ [136, 172])).length = 29 := by
      simp [hw.pkh]
    have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 141 ++ [136, 172])).length := by
      rw [hl]; exact varIntOf_small (by decide)
    have h := readTxOut_bytes (r := r) hw.v0 hv
    simpa only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero] using h
  have hout2 : ∀ r, readTxOut ((item T 139 ++ ([25] ++ item T 138)) ++ r) = some (outOfBytes (item T 139) (item T 138), r) := by
    intro r; simp only [List.append_assoc]
    have hv : VarIntOf [25] (item T 138).length := by rw [hw.p2]; exact varIntOf_small (by decide)
    exact readTxOut_bytes hw.v2 hv
  exact decodeTx_bytes hw.ver (varIntOf_small (n := 2) (by decide)) (readsAs_cons hin0 (readsAs_one hin1))
    (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout2))) hw.lt

