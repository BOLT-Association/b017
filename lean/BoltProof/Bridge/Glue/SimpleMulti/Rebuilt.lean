/-- The rebuilt grandparent as `decodeTx` reads it: the second token input and the second proof output present
when their flags are. -/
def gpTxA (t0 : Bytes) (T : List Bytes) (w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46 : Bytes) : Tx :=
  { version := toInt32 (leNat (item T 211)),
    inputs := inOfBytes (item T 210) (scA0 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) (item T 183) ::
      ((if decode (item T 182) = 0 then [] else
        [inOfBytes ((t0 :: T)[183]?.getD []) (scA2 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46) ((t0 :: T)[156]?.getD [])]) ++
        [inOfBytes (item T 154) (item T 153) (item T 152)]),
    outputs := outOfBytes (item T 30) (lkA T) ::
      outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 141 ++ [136, 172])) ::
      ((if decode (item T 140) = 0 then [] else
        [outOfBytes ((t0 :: T)[31]?.getD []) (((t0 :: T)[13]?.getD []).drop 1 ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))]) ++
        [outOfBytes (item T 139) (item T 138)]),
    lockTime := leNat (item T 137) }

