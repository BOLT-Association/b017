  sq0 : (item T 183).length = 4
  op2 : ¬ decode (item T 182) = 0 → ((t0 :: T)[183]?.getD []).length = 36
  vi2 : ¬ decode (item T 182) = 0 →
    VarIntOf (253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) (scA2 t0 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 w46).length
