  w46 ++ optPush (encode 4) ((item T 209)) ++ optPush (encode 4) ((item T 208)) ++ optPush [20] ((item T 207)) ++ optPush [36] ((item T 206)) ++ optPush [36] ((item T 205)) ++ 36 :: (item T 204) ++ 34 :: (item T 203) ++ optPush [20] ((item T 202)) ++ optPush [20] ((item T 201)) ++ optPush (encode 16) ((item T 200)) ++ optPush [1] ((item T 199)) ++ optPush [1] ((item T 198)) ++ (encode ((List.length ((item T 197)) : Nat) : Int) ++ (item T 197)) ++ optPush [33] ((item T 196)) ++ 76 :: (List.take (((List.length w23 : Nat) : Int) - 1).toNat w23 ++ (item T 195) ++ 3 :: 253 :: (w20 ++ [2, 173, 104] ++ 77 :: (w18 ++ 16 :: ((item T 194) ++ 16 :: (item T 193) ++ 20 :: (item T 192) ++ 20 :: (item T 191) ++ 20 :: (item T 190) ++ 36 :: (item T 189) ++ 1 :: (item T 188) ++ optPush [1] ((item T 187)) ++ 36 :: (item T 186) ++ 36 :: (item T 185) ++ (item T 15) ++ (item T 14))))) ++ (encode ((List.length ((item T 184)) : Nat) : Int) ++ (item T 184)) ++ 3 :: 253 :: w19 ++ 85 :: 121 :: 85 :: 122 :: 85 :: 122 :: 85 :: 121 :: 85 :: 121 :: 126 :: 126 :: 126 :: 126 :: 84 :: 122 :: 82 :: 122 :: 84 :: 122 :: 84 :: 122 :: 126 :: 126 :: 126 :: 124 :: 115 :: 99 :: 1 :: 65 :: (List.take 381 (List.drop 41 ((item T 14))) ++ [171, 173, 104])

