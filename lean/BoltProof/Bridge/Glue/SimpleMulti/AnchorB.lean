import BoltProof.Bridge.Glue.SimpleMulti.RebuiltBParse
import BoltProof.Bridge.Glue.SimpleMulti.Anchor

/-!
# The rebuilt other grandparent's token

`Anchor.lean` for the second rebuild: the other grandparent's commit token is the pieces at depths 67–76 with the
spend's own issuer push and suffix (`lkB`), the fungible lock of `gpFieldsB` at the pieces' widths (`lkB_eq`), so
the parsed other grandparent's first output is that token and its other outputs are not tokens (`gpTxB_token`).
Generated by the glue's `gen_rebuiltB_parse.py`; regenerate rather than edit.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Numbers BsvScript.Tx BsvScript.Sighash
open BoltProof.Glue.Serial
open BoltProof.Bridge.Generated

/-- The grandparent token's fields as the second rebuild's pieces name them, with the spend's own issuer. -/
def gpFieldsB (T : List Bytes) (issuer : Bytes) : Fields :=
  { bal := item T 76, balCommit := item T 75, pkh := item T 74, com := item T 73, com2 := item T 72,
    ogp := item T 71, ty := item T 70, outIdx := item T 69, parent := item T 68, gp := item T 67,
    issuer := issuer }

/-- The other grandparent token's pieces at their push widths. -/
structure LockWidthsB (T : List Bytes) : Prop where
  bal : (item T 76).length = 16
  balCommit : (item T 75).length = 16
  pkh : (item T 74).length = 20
  com : (item T 73).length = 20
  com2 : (item T 72).length = 20
  ogp : (item T 71).length = 36
  ty : (item T 70).length = 1
  outIdx : (item T 69).length = 1
  parent : (item T 68).length = 36
  gp : (item T 67).length = 36

theorem gpFieldsB_wf {T : List Bytes} {issuer : Bytes} (hw : LockWidthsB T) (hi : issuer.length = 33) :
    WF (gpFieldsB T issuer) :=
  ⟨hw.bal, hw.balCommit, hw.pkh, hw.com, hw.com2, hw.ogp, hw.ty, hw.outIdx, hw.parent, hw.gp, hi⟩

/-- The rebuilt token output's script is the fungible lock of the pieces. -/
theorem lkB_eq {T : List Bytes} {issuer : Bytes} (hw : LockWidthsB T) (h15 : item T 15 = 33 :: issuer)
    (h14 : item T 14 = SimpleMulti.suffix) : lkB T = lockScript (gpFieldsB T issuer) := by
  have hidx : encode (((item T 69).length : Nat) : Int) = [1] := by rw [hw.outIdx]; decide
  simp only [lkB, lockScript, gpFieldsB, optPush_of_width hidx, h15, h14, List.append_assoc, List.cons_append,
    List.nil_append]

/-- The parsed other grandparent's token: its first output, and no other. -/
theorem gpTxB_token {t1 t0 a1 a2 : Bytes} {T : List Bytes} {w10 w11 w12 w13 w14 w17 w18 w19 w20 w23 : Bytes}
    {issuer : Bytes} (hw : WidthsB t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23) (hl : LockWidthsB T)
    (hi : issuer.length = 33) (h15 : item T 15 = 33 :: issuer) (h14 : item T 14 = SimpleMulti.suffix)
    (j : Nat) (t : BoltProof.Token Bytes)
    (hj : ((gpTxB t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).outputs.map outOf)[j]? = some (.token t)) :
    j = 0 ∧ t = tokenOf (gpFieldsB T issuer) := by
  have h0 : outOf (outOfBytes (item T 30) (lkB T)) = .token (tokenOf (gpFieldsB T issuer)) := by
    simp only [outOf, outOfBytes, lkB_eq hl h15 h14, decodeLock_lockScript (gpFieldsB_wf hl hi)]
  have h1 := outOf_short (o := outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 66 ++ [136, 172])))
    (by simp [outOfBytes, hw.pt, hw.pkh])
  have h3 := outOf_short (o := outOfBytes (item T 64) (item T 63)) (by simp [outOfBytes, hw.p2])
  have houts : (gpTxB t1 t0 a1 a2 T w10 w11 w12 w13 w14 w17 w18 w19 w20 w23).outputs =
      outOfBytes (item T 30) (lkB T) ::
      outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 66 ++ [136, 172])) ::
      ((if decode (item T 65) = 0 then [] else
        [outOfBytes ((t1 :: t0 :: T)[32]?.getD []) (((t1 :: t0 :: T)[14]?.getD []).drop 1 ++ ((t1 :: t0 :: T)[67]?.getD [] ++ [136, 172]))]) ++
        [outOfBytes (item T 64) (item T 63)]) := rfl
  rw [houts] at hj
  rcases j with _ | _ | j
  · simp only [List.map_cons, List.getElem?_cons_zero, Option.some.injEq] at hj
    rw [h0] at hj
    exact ⟨rfl, (BoltProof.Out.token.inj hj).symm⟩
  · simp only [List.map_cons, List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hj
    exact absurd hj (h1 t)
  · by_cases h140 : decode (item T 65) = 0
    · simp only [h140, ↓reduceIte, List.nil_append, List.map_cons, List.map_nil, List.getElem?_cons_succ] at hj
      rcases j with _ | j
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; exact absurd hj (h3 t)
      · simp at hj
    · have hp2 : ((t1 :: t0 :: T)[67]?.getD []).length = 20 := hw.pkh2 h140
      have hpt : (t1 :: t0 :: T)[14]?.getD [] = [29, 2, 176, 23, 136, 118, 169, 20] := hw.pt
      have h2 := outOf_short (o := outOfBytes ((t1 :: t0 :: T)[32]?.getD [])
        (((t1 :: t0 :: T)[14]?.getD []).drop 1 ++ ((t1 :: t0 :: T)[67]?.getD [] ++ [136, 172])))
        (by simp only [outOfBytes, hpt, List.length_append, hp2]; decide)
      simp only [h140, ↓reduceIte, List.singleton_append, List.map_cons, List.map_nil, List.getElem?_cons_succ] at hj
      rcases j with _ | _ | j
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; exact absurd hj (h2 t)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hj; exact absurd hj (h3 t)
      · simp at hj


end BoltProof.Glue.SimpleMulti
