theorem inv_endif {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env)
    (h : run Eval.opExec env (Op.OP_ENDIF :: g) t (St (S) A m C k cs) = r) (hr : r.IsOk) :
    ∃ m' k', run Eval.opExec env g t (St (S) A m' C.opEndif k' cs) = r := by
