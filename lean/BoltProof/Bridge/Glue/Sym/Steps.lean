theorem inv_fromalt {env : Env} {g t : Bytes} {r : GOut} {x : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_FROMALTSTACK :: g) t (St (S) (x :: A) m C k cs) = r) (hr : r.IsOk) :
    ∃ m' k', run Eval.opExec env g t (St (x :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals inv_close h hr

