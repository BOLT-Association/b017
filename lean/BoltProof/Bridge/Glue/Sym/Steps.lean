    | (simp only [ne_eq, *]; refine ⟨by first | assumption | rfl | simp_all, _, _, h⟩)

/-- `OP_MOD`: the divisor must be non-zero; `Int.tmod b1 b2` pushed. -/
theorem inv_mod {env : Env} {g t : Bytes} {r : GOut} {b2 b1 : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_MOD :: g) t (St (b2 :: b1 :: S) A m C k cs) = r) (hr : r.IsOk) :
    ¬ decode b2 = 0 ∧
      ∃ m' k', run Eval.opExec env g t (St (encode (Int.tmod (decode b1) (decode b2)) :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by first | assumption | simp_all, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by first | assumption | simp_all, _, _, h⟩)

/-- `OP_NUM2BIN`: the width popped, the number below re-encoded to that width (which must fit). -/
theorem inv_num2bin {env : Env} {g t : Bytes} {r : GOut} {nb x : Bytes} {S A : List Bytes} {C : Cond}
    {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_NUM2BIN :: g) t (St (nb :: x :: S) A m C k cs) = r) (hr : r.IsOk) :
    ∃ y, num2bin x (decode nb).toNat = some y ∧
      ∃ m' k', run Eval.opExec env g t (St (y :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals (rcases hn : num2bin x (decode nb).toNat with _ | y <;> (try simp only [hn] at h) <;> inv_simp at h <;> inv_split h)
  all_goals first
    | (subst h; simp at hr)
    | (exact ⟨_, rfl, _, _, h⟩)
    | (simp only [ne_eq, *]; exact ⟨_, rfl, _, _, h⟩)

/-- `OP_CHECKSIGVERIFY` in phase 2 (no `checksigData`): the key on top, the signature below,
both encodings accepted, the context's checker passed on the script from the last separator. -/
theorem inv_checksigverify {env : Env} {g t : Bytes} {r : GOut} {pk sig : Bytes} {S A : List Bytes}
    {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_CHECKSIGVERIFY :: g) t (St (pk :: sig :: S) A m C k cs) = r) (hr : r.IsOk) :
    Ops.Crypto.checkSignatureEncoding env sig = .ok () ∧ Ops.Crypto.checkPubKeyEncoding env pk = .ok () ∧
      env.ctx.checkSig sig pk (Sighash.cleanupScriptCode cs sig true) true = true ∧
      ∃ m' k', run Eval.opExec env g t (St S A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  rcases hse : Ops.Crypto.checkSignatureEncoding env sig with _ | e₁ <;>
  rcases hpe : Ops.Crypto.checkPubKeyEncoding env pk with _ | e₂ <;>
  rcases hok : env.ctx.checkSig sig pk (Sighash.cleanupScriptCode cs sig true) true <;>
  simp only [hse, hpe, hok] at h <;> inv_simp at h <;> inv_split h
  all_goals first
    | (subst h; simp at hr)
    | exact ⟨rfl, rfl, rfl, _, _, h⟩

/-- `OP_CHECKSIG` in phase 2: as the verify form, the result pushed instead of demanded. -/
theorem inv_checksig {env : Env} {g t : Bytes} {r : GOut} {pk sig : Bytes} {S A : List Bytes}
    {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_CHECKSIG :: g) t (St (pk :: sig :: S) A m C k cs) = r) (hr : r.IsOk) :
    Ops.Crypto.checkSignatureEncoding env sig = .ok () ∧ Ops.Crypto.checkPubKeyEncoding env pk = .ok () ∧
      ∃ m' k', run Eval.opExec env g t
        (St ((if env.ctx.checkSig sig pk (Sighash.cleanupScriptCode cs sig true) true then [1] else []) :: S)
          A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  rcases hse : Ops.Crypto.checkSignatureEncoding env sig with _ | e₁ <;>
  rcases hpe : Ops.Crypto.checkPubKeyEncoding env pk with _ | e₂ <;>
  rcases hok : env.ctx.checkSig sig pk (Sighash.cleanupScriptCode cs sig true) true <;>
  simp only [hse, hpe, hok] at h <;> inv_simp at h <;> inv_split h
  all_goals first
    | (subst h; simp at hr)
    | exact ⟨rfl, rfl, _, _, h⟩

