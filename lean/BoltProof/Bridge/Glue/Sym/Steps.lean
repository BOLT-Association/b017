import BoltProof.Bridge.Glue.Sym.Basic

/-!
# Inversion step lemmas

One lemma per opcode the covenant locks use, each read backwards: if the run of `op :: g` from an
explicit state reached an outcome the script can continue from (`IsOk`), then `op` succeeded, the
fact it checks holds, and the run of `g` from the resulting state is the same outcome. The memory
counter and the opcode count are existentially abstracted (they never decide anything under the
Chronicle limits); the stack, the alt stack, the conditional tracker and the separator position
are tracked exactly.

Compared with the forward lemmas of `Gadgets/Steps.lean`, no limit hypothesis is needed: every
limit check returns an error outcome, which `IsOk` refutes. The proofs all run the same way:
unfold one loop step (`run.eq_2`, the parser evaluated on the opcode), simplify under `EnvOK`
(`inv_simp`), split the `if`s that surface layer by layer (`inv_split`), and close each branch
(`inv_close`): the surviving branch is the run of `g`, every other names an error.

Generated by `scripts/gen-sym-steps.py` from its table; edit the table, not this file.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace BoltProof.Glue

open BsvScript BsvScript.Params BsvScript.Numbers BsvScript.Machine BsvScript.Gadget

/-- `OP_0`: the empty vector pushed. -/
theorem inv_push0 {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_0 :: g) t (St (S) A m C k cs) = r) (hr : r.IsOk) :
    ∃ m' k', run Eval.opExec env g t (St ([] :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2, getOpTail_push0] at h
  inv_simp at h
  inv_split h
  all_goals inv_close h hr

/-- A direct push of 1 byte: the next 1 byte of the program pushed; the program must hold them. -/
theorem inv_push_1 {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat}
    (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (1 :: g) t (St S A m C k cs) = r) (hr : r.IsOk) :
    1 ≤ g.length ∧ ∃ m' k', run Eval.opExec env (g.drop 1) t (St (g.take 1 :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2, getOpTail_push (n := 1) (by decide)] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by omega, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by omega, _, _, h⟩)
    | (rw [List.drop_one]; exact ⟨List.length_pos_of_ne_nil (by assumption), _, _, h⟩)

