/-- `OP_ELSE`, executing or not: the innermost condition flipped. -/
theorem inv_else {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env)
