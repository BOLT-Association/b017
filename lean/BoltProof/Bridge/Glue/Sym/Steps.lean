/-- `OP_PICK`: the index popped (a non-negative number below the depth), the element that deep copied to the top. -/
theorem inv_pick {env : Env} {g t : Bytes} {r : GOut} {idx : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_PICK :: g) t (St (idx :: S) A m C k cs) = r) (hr : r.IsOk) :
    0 ≤ decode idx ∧ (decode idx).toNat < S.length ∧
      ∃ m' k', run Eval.opExec env g t (St (S[(decode idx).toNat]?.getD [] :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by omega, by omega, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by omega, by omega, _, _, h⟩)

/-- `OP_ROLL`: as `OP_PICK`, the element moved rather than copied. -/
theorem inv_roll {env : Env} {g t : Bytes} {r : GOut} {idx : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_ROLL :: g) t (St (idx :: S) A m C k cs) = r) (hr : r.IsOk) :
    0 ≤ decode idx ∧ (decode idx).toNat < S.length ∧
      ∃ m' k', run Eval.opExec env g t (St (S[(decode idx).toNat]?.getD [] :: S.eraseIdx (decode idx).toNat) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by omega, by omega, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by omega, by omega, _, _, h⟩)

/-- `OP_SPLIT`: the position popped (a number within the element), the element split there, the right half on top. -/
theorem inv_split {env : Env} {g t : Bytes} {r : GOut} {nb x : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_SPLIT :: g) t (St (nb :: x :: S) A m C k cs) = r) (hr : r.IsOk) :
    0 ≤ decode nb ∧ (decode nb).toNat ≤ x.length ∧
      ∃ m' k', run Eval.opExec env g t (St (x.drop (decode nb).toNat :: x.take (decode nb).toNat :: S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by omega, by omega, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by omega, by omega, _, _, h⟩)

/-- `OP_EQUALVERIFY`: the top two must be equal; both popped. -/
theorem inv_equalverify {env : Env} {g t : Bytes} {r : GOut} {x y : Bytes} {S A : List Bytes} {C : Cond} {cs : Bytes} {m k : Nat} (he : EnvOK env) (hact : C.isActive = true)
    (h : run Eval.opExec env (Op.OP_EQUALVERIFY :: g) t (St (x :: y :: S) A m C k cs) = r) (hr : r.IsOk) :
    y = x ∧
      ∃ m' k', run Eval.opExec env g t (St (S) A m' C k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2] at h
  inv_simp at h
  inv_split h
  all_goals first
    | (subst h; simp at hr)
    | (refine ⟨by first | assumption | rfl | simp_all, _, _, h⟩)
    | (simp only [ne_eq, *]; refine ⟨by first | assumption | rfl | simp_all, _, _, h⟩)

/-- `OP_VERIFY`: the top must be true; popped. -/
