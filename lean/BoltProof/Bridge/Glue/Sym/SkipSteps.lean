import BoltProof.Bridge.Glue.Sym.Basic

/-!
# Inactive step lemmas

Inside a branch the conditional tracker marks inactive, the loop parses every instruction and
counts the opcodes but executes nothing except the flow opcodes (`Sym/Skip.lean`). One lemma per
opcode and push width the locks use: the program advances, the stack, the alt stack, the memory
counter, the tracker and the separator stay. `sym_skip` (`Sym/Tactic.lean`) walks a skipped arm
with them.

Generated by `scripts/gen-sym-steps.py` from its table; edit the table, not this file.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace BoltProof.Glue

open BsvScript BsvScript.Params BsvScript.Numbers BsvScript.Machine BsvScript.Gadget

/-- `OP_0`, inactive: parsed, nothing pushed. -/
theorem inv_skip_push0 {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {D : Cond} {cs : Bytes} {m k : Nat}
    (he : EnvOK env) (hin : D.isActive = false)
    (h : run Eval.opExec env (Op.OP_0 :: g) t (St S A m D k cs) = r) (hr : r.IsOk) :
    ∃ k', run Eval.opExec env (g) t (St S A m D k' cs) = r := by
  obtain ⟨hgen, hera, hmin, hminif, hfork, hcs⟩ := he
  rw [run.eq_2, getOpTail_push0] at h
  inv_simp at h
  inv_split h
  all_goals first
    | exact ⟨_, h⟩
    | (subst h; simp at hr)
    | (simp only [ne_eq, *]; exact ⟨_, h⟩)

/-- A direct push of 1 byte, inactive: parsed (the program must hold the data), nothing pushed. -/
theorem inv_skip_push_1 {env : Env} {g t : Bytes} {r : GOut} {S A : List Bytes} {D : Cond} {cs : Bytes} {m k : Nat}
