import BoltProof.Bridge.Glue.SimpleMulti.Regions
import BoltProof.Bridge.Glue.Refine.Parse

/-!
# The first rebuild's bytes, parsed

The first rebuild (suffix 1426–2714) hashes a transaction it assembles from the pieces and the spend's own
fields, and compares the hash with the grandparent's txid (`rebuildA_fact1`). Under second-preimage freedom
those bytes are the grandparent's serialisation, so the grandparent is what `decodeTx` reads from them. This
file names the bytes (`rebuiltA`), lays them out field by field for each of the two optional arms (`rebuiltA_00`
… `rebuiltA_11`: a second token input when the piece at depth 182 is non-zero, as a merge commit has, and a second
proof output when the piece at depth 140 is non-zero, as a split commit has) and reads them (`decode_rebuiltA`):
the first input spends the settled token with the unlocking script the rebuild assembles (`scA0`), the optional
second token input has its own (`scA2`), the last input is the fee input; the outputs are the commit token
(`lkA`, the pieces at depths 142–151 with the spend's issuer push and suffix), the pay-to-proof output, the
optional second one, and a P2PKH output. The decode takes the widths the parse reads as hypotheses (`WidthsA`):
the run fixes some of them (the version, the scripts' varints), the rest are pieces the bytes push without a
size check. Generated by the glue's `gen_rebuilt.py` from the region's facts; regenerate rather than edit.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace BoltProof.Glue.SimpleMulti

open BsvScript BsvScript.Numbers BsvScript.Tx BsvScript.Sighash
open BoltProof.Glue.Serial

theorem castToBool_encode_one : castToBool (encode 1) = true := by decide
theorem encode_four' : encode 4 = [4] := by decide

/-- The bytes the first rebuild hashes against the grandparent's txid. -/
def rebuiltA PARAMS : Bytes :=
  XBYTES

theorem rebuildA_fact1_eq PARAMS :
    rebuildA_fact1 ARGS = (Hash.hash256 (rebuiltA ARGS) = List.take 32 (item T 36)) := rfl

/-- The unlocking script the first rebuild assembles for the grandparent's first input: 150 empty pushes,
the grandparent spend's own arguments, its preimage with the settled token's lock, its `OP_PUSH_TX` key. -/
def scA0 PARAMS : Bytes :=
  SC0BYTES

theorem rebuildA_fact3_eq PARAMS :
    rebuildA_fact3 ARGS = (num2bin (encode ((scA0 ARGS).length : Int)) (decode (encode 3)).toNat = some w17) := rfl

/-- The unlocking script of the grandparent's optional second token input, from the pieces at depths 156–181. -/
def scA2 PARAMS : Bytes :=
  SC2BYTES

/-- The second token input's facts the parse needs (fact 2, under its flag): the script's length word, the
length words inside it, the widths of its preimage push and key push. -/
theorem rebuildA_fact2_parts PARAMS (h2 : rebuildA_fact2 ARGS)
    (h182 : ¬ decode (item T 182) = 0) :
    num2bin (encode ((scA2 ARGS).length : Int)) (decode (encode 3)).toNat = some w14 ∧
      w13.length = 2 ∧ w12.length = 2 ∧ w11.length = 2 ∧ w10.length = 2 ∧
      encode (((item T 167).length : Nat) : Int) = [104] := by
  have h := h2 (by simp only [h182, ↓reduceIte, castToBool_encode_one])
  obtain ⟨h1, -, h3, h4, h5, h6, h7, -⟩ := h
  refine ⟨h1, ?_, ?_, ?_, ?_, h7⟩
  · rw [num2bin_length _ _ _ h3]; decide
  · rw [num2bin_length _ _ _ h4]; decide
  · rw [num2bin_length _ _ _ h5]; decide
  · rw [num2bin_length _ _ _ h6]; decide

/-- The commit token's lock in the rebuilt grandparent: the pieces at depths 142–151, then the spend's own
issuer push and suffix. -/
def lkA (T : List Bytes) : Bytes :=
  16 :: (item T 151) ++ 16 :: (item T 150) ++ 20 :: (item T 149) ++ 20 :: (item T 148) ++ 20 :: (item T 147) ++
    36 :: (item T 146) ++ 1 :: (item T 145) ++ optPush [1] ((item T 144)) ++ 36 :: (item T 143) ++
    36 :: (item T 142) ++ (item T 15) ++ (item T 14)

LAYOUTS

/-- The rebuilt grandparent as `decodeTx` reads it: the second token input and the second proof output present
when their flags are. -/
def gpTxA PARAMS : Tx :=
  { version := toInt32 (leNat (item T 211)),
    inputs := inOfBytes (item T 210) (scA0 ARGS) (item T 183) ::
      ((if decode (item T 182) = 0 then [] else
        [inOfBytes ((t0 :: T)[183]?.getD []) (scA2 ARGS) ((t0 :: T)[156]?.getD [])]) ++
        [inOfBytes (item T 154) (item T 153) (item T 152)]),
    outputs := outOfBytes (item T 30) (lkA T) ::
      outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 141 ++ [136, 172])) ::
      ((if decode (item T 140) = 0 then [] else
        [outOfBytes ((t0 :: T)[31]?.getD []) (((t0 :: T)[13]?.getD []).drop 1 ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))]) ++
        [outOfBytes (item T 139) (item T 138)]),
    lockTime := leNat (item T 137) }

/-- The widths the parse of the rebuilt grandparent reads. -/
structure WidthsA PARAMS : Prop where
  ver : (item T 211).length = 4
  op0 : (item T 210).length = 36
  vi0 : VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scA0 ARGS).length
  sq0 : (item T 183).length = 4
  op2 : ¬ decode (item T 182) = 0 → ((t0 :: T)[183]?.getD []).length = 36
  vi2 : ¬ decode (item T 182) = 0 →
    VarIntOf (253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) (scA2 ARGS).length
  sq2 : ¬ decode (item T 182) = 0 → ((t0 :: T)[156]?.getD []).length = 4
  op1 : (item T 154).length = 36
  vi1 : VarIntOf (encode ((item T 153).length : Int)) (item T 153).length
  sq1 : (item T 152).length = 4
  v0 : (item T 30).length = 8
  lk : VarIntOf (item T 0) (lkA T).length
  pt : item T 12 = [29, 2, 176, 23, 136, 118, 169, 20]
  pkh : (item T 141).length = 20
  pkh2 : ¬ decode (item T 140) = 0 → ((t0 :: T)[141]?.getD []).length = 20
  v2 : (item T 139).length = 8
  p2 : (item T 138).length = 25
  lt : (item T 137).length = 4

/-- The version's width, from the run (fact 12). -/
theorem widthA_ver PARAMS (h12 : rebuildA_fact12 ARGS) : (item T 211).length = 4 :=
  len_of_encode_eq h12

/-- The first input's varint, from the run (facts 3, 9 and 11): the length word the rebuild measured, below
the two-byte bound. -/
theorem widthA_vi0 PARAMS (h3 : rebuildA_fact3 ARGS) (h9 : rebuildA_fact9 ARGS) (h11 : rebuildA_fact11 ARGS)
    (hhi : (scA0 ARGS).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) (scA0 ARGS).length := by
  have h46 : w46.length = 150 := by
    have := num2bin_length _ _ _ h11
    rw [this]; decide
  have h195 : (item T 195).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [h9]; decide)
  have hlo : 253 ≤ (scA0 ARGS).length := by
    simp only [scA0, List.length_append, List.length_cons] at *
    omega
  rw [rebuildA_fact3_eq] at h3
  exact varIntOf_num2bin3 h3 hlo hhi

/-- The second token input's varint, from the run (facts 2 and 11), below the two-byte bound. -/
theorem widthA_vi2 PARAMS (h2 : rebuildA_fact2 ARGS) (h11 : rebuildA_fact11 ARGS)
    (h182 : ¬ decode (item T 182) = 0) (hhi : (scA2 ARGS).length < 65536) :
    VarIntOf (253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) (scA2 ARGS).length := by
  obtain ⟨hv, -, -, -, -, h167⟩ := rebuildA_fact2_parts ARGS h2 h182
  have h46 : w46.length = 150 := by
    have := num2bin_length _ _ _ h11
    rw [this]; decide
  have h168 : ((t0 :: T)[168]?.getD []).length = 104 :=
    len_of_encode_eq (k := 104) (by rw [show (t0 :: T)[168]?.getD [] = item T 167 from rfl, h167]; decide)
  have hlo : 253 ≤ (scA2 ARGS).length := by
    simp only [scA2, List.length_append, List.length_cons] at *
    omega
  exact varIntOf_num2bin3 hv hlo hhi

/-- **The first rebuild, parsed**: the bytes it hashes read as `gpTxA`. -/
theorem decode_rebuiltA PARAMS (hw : WidthsA ARGS) :
    decodeTx (rebuiltA ARGS) = some (gpTxA ARGS) := by
  have hin0 : ∀ r, readTxIn ((item T 210 ++ ((253 :: List.take (((List.length w17 : Nat) : Int) - 1).toNat w17) ++
      (scA0 ARGS ++ item T 183))) ++ r) = some (inOfBytes (item T 210) (scA0 ARGS) (item T 183), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op0 hw.vi0 hw.sq0
  have hin1 : ∀ r, readTxIn ((item T 154 ++ (encode ((item T 153).length : Int) ++ (item T 153 ++ item T 152))) ++ r) =
      some (inOfBytes (item T 154) (item T 153) (item T 152), r) := by
    intro r; simp only [List.append_assoc]; exact readTxIn_bytes hw.op1 hw.vi1 hw.sq1
  have hout0 : ∀ r, readTxOut ((item T 30 ++ (item T 0 ++ lkA T)) ++ r) = some (outOfBytes (item T 30) (lkA T), r) := by
    intro r; simp only [List.append_assoc]; exact readTxOut_bytes hw.v0 hw.lk
  have hl1 : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 141 ++ [136, 172])).length = 29 := by
    simp [hw.pkh]
  have hout1 : ∀ r, readTxOut ((item T 30 ++ (item T 12 ++ (item T 141 ++ [136, 172]))) ++ r) =
      some (outOfBytes (item T 30) ((item T 12).drop 1 ++ (item T 141 ++ [136, 172])), r) := by
    intro r
    rw [hw.pt]
    have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ (item T 141 ++ [136, 172])).length := by
      rw [hl1]; exact varIntOf_small (by decide)
    have h := readTxOut_bytes (r := r) hw.v0 hv
    simpa only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero] using h
  have hout3 : ∀ r, readTxOut ((item T 139 ++ ([25] ++ item T 138)) ++ r) = some (outOfBytes (item T 139) (item T 138), r) := by
    intro r; simp only [List.append_assoc]
    have hv : VarIntOf [25] (item T 138).length := by rw [hw.p2]; exact varIntOf_small (by decide)
    exact readTxOut_bytes hw.v2 hv
  by_cases h140 : decode (item T 140) = 0 <;> by_cases h182 : decode (item T 182) = 0
  · rw [rebuiltA_00 ARGS h140 h182]
    simp only [gpTxA, h140, h182, ↓reduceIte, List.nil_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 2) (by decide)) (readsAs_cons hin0 (readsAs_one hin1))
      (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout3))) hw.lt
  · have hin2 : ∀ r, readTxIn (((t0 :: T)[183]?.getD [] ++ ((253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) ++
        (scA2 ARGS ++ (t0 :: T)[156]?.getD []))) ++ r) =
        some (inOfBytes ((t0 :: T)[183]?.getD []) (scA2 ARGS) ((t0 :: T)[156]?.getD []), r) := by
      intro r; simp only [List.append_assoc]; exact readTxIn_bytes (hw.op2 h182) (hw.vi2 h182) (hw.sq2 h182)
    rw [rebuiltA_01 ARGS h140 h182]
    simp only [gpTxA, h140, h182, ↓reduceIte, List.nil_append, List.singleton_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 3) (by decide))
      (readsAs_cons hin0 (readsAs_cons hin2 (readsAs_one hin1)))
      (varIntOf_small (n := 3) (by decide)) (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_one hout3))) hw.lt
  · have hout2 : ∀ r, readTxOut (((t0 :: T)[31]?.getD [] ++ ((t0 :: T)[13]?.getD [] ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))) ++ r) =
        some (outOfBytes ((t0 :: T)[31]?.getD []) (((t0 :: T)[13]?.getD []).drop 1 ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])), r) := by
      intro r
      have hpt : (t0 :: T)[13]?.getD [] = [29, 2, 176, 23, 136, 118, 169, 20] := hw.pt
      rw [hpt]
      have hp2 : ((t0 :: T)[141]?.getD []).length = 20 := hw.pkh2 h140
      have hl2 : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])).length = 29 := by
        rw [List.length_append, List.length_append, hp2]; rfl
      have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])).length := by
        rw [hl2]; exact varIntOf_small (by decide)
      have h := readTxOut_bytes (r := r) (hw.v0 : ((t0 :: T)[31]?.getD []).length = 8) hv
      have e : ((t0 :: T)[31]?.getD [] ++ ([29, 2, 176, 23, 136, 118, 169, 20] ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))) ++ r =
          (t0 :: T)[31]?.getD [] ++ ([29] ++ (((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++
            ((t0 :: T)[141]?.getD [] ++ [136, 172])) ++ r)) := by
        simp only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero]
      rw [e]; exact h
    rw [rebuiltA_10 ARGS h140 h182]
    simp only [gpTxA, h140, h182, ↓reduceIte, List.nil_append, List.singleton_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 2) (by decide)) (readsAs_cons hin0 (readsAs_one hin1))
      (varIntOf_small (n := 4) (by decide))
      (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_cons hout2 (readsAs_one hout3)))) hw.lt
  · have hin2 : ∀ r, readTxIn (((t0 :: T)[183]?.getD [] ++ ((253 :: List.take (((List.length w14 : Nat) : Int) - 1).toNat w14) ++
        (scA2 ARGS ++ (t0 :: T)[156]?.getD []))) ++ r) =
        some (inOfBytes ((t0 :: T)[183]?.getD []) (scA2 ARGS) ((t0 :: T)[156]?.getD []), r) := by
      intro r; simp only [List.append_assoc]; exact readTxIn_bytes (hw.op2 h182) (hw.vi2 h182) (hw.sq2 h182)
    have hout2 : ∀ r, readTxOut (((t0 :: T)[31]?.getD [] ++ ((t0 :: T)[13]?.getD [] ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))) ++ r) =
        some (outOfBytes ((t0 :: T)[31]?.getD []) (((t0 :: T)[13]?.getD []).drop 1 ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])), r) := by
      intro r
      have hpt : (t0 :: T)[13]?.getD [] = [29, 2, 176, 23, 136, 118, 169, 20] := hw.pt
      rw [hpt]
      have hp2 : ((t0 :: T)[141]?.getD []).length = 20 := hw.pkh2 h140
      have hl2 : ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])).length = 29 := by
        rw [List.length_append, List.length_append, hp2]; rfl
      have hv : VarIntOf [29] ((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++ ((t0 :: T)[141]?.getD [] ++ [136, 172])).length := by
        rw [hl2]; exact varIntOf_small (by decide)
      have h := readTxOut_bytes (r := r) (hw.v0 : ((t0 :: T)[31]?.getD []).length = 8) hv
      have e : ((t0 :: T)[31]?.getD [] ++ ([29, 2, 176, 23, 136, 118, 169, 20] ++ ((t0 :: T)[141]?.getD [] ++ [136, 172]))) ++ r =
          (t0 :: T)[31]?.getD [] ++ ([29] ++ (((List.drop 1 [29, 2, 176, 23, 136, 118, 169, 20]) ++
            ((t0 :: T)[141]?.getD [] ++ [136, 172])) ++ r)) := by
        simp only [List.append_assoc, List.cons_append, List.nil_append, List.drop_succ_cons, List.drop_zero]
      rw [e]; exact h
    rw [rebuiltA_11 ARGS h140 h182]
    simp only [gpTxA, h140, h182, ↓reduceIte, List.nil_append, List.singleton_append]
    exact decodeTx_bytes hw.ver (varIntOf_small (n := 3) (by decide))
      (readsAs_cons hin0 (readsAs_cons hin2 (readsAs_one hin1)))
      (varIntOf_small (n := 4) (by decide))
      (readsAs_cons hout0 (readsAs_cons hout1 (readsAs_cons hout2 (readsAs_one hout3)))) hw.lt

end BoltProof.Glue.SimpleMulti
